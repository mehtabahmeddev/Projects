void Team1() {
    string size;   
    int a = 0;   
    
    cout << "Enter Name of Team 1: ";
    cin.ignore();  
    getline(cin, team1Name);  
    
    bool isValid = false;
    while (!isValid) {
        cout << "Enter Size of Team : ";
        cin >> size;
		cout << "-----------------------------------------------------------------------" << endl;  

        bool allDigits = true;
        for (int i = 0; i < size.length(); i++) {
            if (!isdigit(size[i])) {
                allDigits = false; 
                break;
            }
        }

        if (allDigits) {
            a = 0;
            for (int i = 0; i < size.length(); i++) {
                a = a * 10 + (size[i] - '0'); 
            }

            if (a >= 2 && a <= 11) {
                team1size = a;  		 
                isValid = true;  
            } else {
                cout << "Please Enter Number Between 2 and 11." << endl;
            }
        } else {
            cout << "INVALID INPUT. Please Enter Valid Number." << endl;
        }
    }
}

